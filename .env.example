# Public site origin. Use the Workers preview or production URL after deploy.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-long-random-string

# Optional. The Google button explains itself when these are empty.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# console prints OTP locally. Add another provider in lib/sms.ts.
SMS_PROVIDER=console
# Echoes the latest dev OTP to the login screen. Never enable in production.
SMS_DEV_ECHO=true

# Leave empty to use the stub checkout. Live mode calls Razorpay when both keys are set.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Map tiles load in the browser only. The page shows a placeholder without a token.
NEXT_PUBLIC_MAPBOX_TOKEN=
